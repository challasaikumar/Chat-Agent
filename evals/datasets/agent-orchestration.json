  "cases": [
    {
      "id": "agent-no-search-math",
      "name": "Simple arithmetic without web search",
      "version": 1,
      "category": "agent_orchestration",
      "tags": ["tools", "no-search"],
      "mode": "deterministic",
      "clock": {
        "now": "2026-11-13T12:00:00.000+05:30",
        "timeZone": "Asia/Kolkata"
      },
      "initialState": {
        "conversations": [{ "title": "Math", "messages": [] }]
      },
      "conversationSequence": [
        { "message": "What is 10 multiplied by 5?" }
      ],
      "openaiFixtures": [
        {
          "finalAnswer": {
            "answer": "10 multiplied by 5 is 50.",
            "citations": []
          }
        }
      ],
      "expected": {
        "mustNotSearch": true,
        "maxSearchCalls": 0,
        "answerMustContain": ["50"]
      },
      "grading": { "critical": ["mustNotSearch"], "soft": [], "useLlmJudge": false },
      "limits": { "timeoutMs": 30000 }
    },
    {
      "id": "agent-must-search-pricing",
      "name": "Current pricing requires web_search",
      "version": 1,
      "category": "agent_orchestration",
      "tags": ["tools", "search"],
