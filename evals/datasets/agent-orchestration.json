      "conversationSequence": [
        { "message": "What is the latest pricing of provider AcmeCloud?", "expectSearch": true }
      ],
      "searchFixtures": [
        {
          "queryContains": "AcmeCloud",
          "results": [
            {
              "title": "AcmeCloud Pricing",
              "url": "https://acmecloud.example.com/pricing",
              "domain": "acmecloud.example.com",
              "content": "AcmeCloud Pro is $12.00 per month.",
              "publishedAt": "2026-11-12T00:00:00.000Z"
            }
          ]
        }
      ],
      "openaiFixtures": [
        {
          "functionCalls": [
            {
              "name": "web_search",
              "arguments": { "query": "AcmeCloud latest pricing", "searchDepth": "basic", "maxResults": 5 }
            }
          ]
        },
        {
          "finalAnswer": {
            "answer": "AcmeCloud Pro is $12.00 per month according to the official pricing page.",
            "citations": []
          }
        }
      ],
      "expected": {
        "mustSearch": true,
        "maxSearchCalls": 3,
        "answerMustContain": ["12"]
      },
      "grading": { "critical": ["mustSearch"], "soft": [], "useLlmJudge": false },
      "limits": { "timeoutMs": 60000 }
    },
