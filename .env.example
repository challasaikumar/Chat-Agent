# Application
NODE_ENV=development
API_PORT=3001
# Behind Nginx use 127.0.0.1; local/dev may use 0.0.0.0
API_HOST=0.0.0.0

# Database — Supabase Postgres (SQLite has been removed; DATABASE_PATH is ignored)
# Supabase Dashboard → Project Settings → Database → Connection string (URI).
#   Long-running Fastify API (this repo): Session pooler / direct connection, port 5432.
#   Transaction pooler (port 6543) also works — prepared statements are disabled automatically.
#   Local dev alternative: postgresql://postgres:postgres@127.0.0.1:5432/minimi
DATABASE_URL=
DATABASE_POOL_MAX=10
# Disposable Postgres for Vitest (tests create/drop one schema per test DB). Never point at production.
# DB-backed tests are skipped when unset, e.g. postgresql://postgres:postgres@127.0.0.1:5432/minimi_test
DATABASE_URL_TEST=

# Supabase (optional) — used only by src/db/supabase.ts for admin/Storage later.
# Core persistence is drizzle-orm + postgres.js via DATABASE_URL; app auth stays cookie-session based.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=            # alternative to SUPABASE_ANON_KEY (new-style publishable key)
# SUPABASE_SERVICE_ROLE_KEY=           # server-only; never expose to the browser

# Local development user (AUTH_MODE=local_dev only — never production)
LOCAL_USER_ID=local-dev-user
APP_TIME_ZONE=Asia/Kolkata

# Authentication (Phase 11)
# local_dev: single LOCAL_USER_ID (tests/dev). session: cookie sessions (production).
AUTH_MODE=local_dev
AUTH_REGISTRATION_MODE=disabled
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=60
AUTH_SESSION_ABSOLUTE_TIMEOUT_HOURS=168
AUTH_COOKIE_NAME=minimi_session
# Production HTTPS cookie: AUTH_COOKIE_NAME=__Host-minimi_session
AUTH_CSRF_HEADER=x-csrf-token
# Comma-separated. Supports https://*.vercel.app for all Vercel preview/prod hosts.
APP_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app
# Bootstrap via `npm run auth:bootstrap` — never commit these values
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000

# LLM — free path (recommended): OpenRouter + agentic free model
# Get a free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free
OPENAI_STRUCTURED_OUTPUT=false
OPENAI_HTTP_REFERER=http://localhost:5173
OPENAI_APP_TITLE=Minimi Research Agent
# Paid OpenAI alternative (leave OPENROUTER_API_KEY empty and unset OPENAI_BASE_URL):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_MAX_RETRIES=2

# Tavily (optional at startup — required for research/search and agent web_search)
TAVILY_API_KEY=

# Search defaults
SEARCH_DEFAULT_DEPTH=basic
SEARCH_DEFAULT_RESULTS=8
SEARCH_MAX_RESULTS=20
SEARCH_TIMEOUT_MS=30000
SEARCH_MAX_CONTENT_LENGTH=12000

# Agent orchestration (Phase 04)
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_MAX_SEARCHES_PER_TURN=3
AGENT_MAX_RECENT_MESSAGES=12
AGENT_MAX_CONTEXT_CHARS=24000
AGENT_MAX_MEMORY_FACTS=20
AGENT_MAX_RESEARCH_SNAPSHOTS=8
AGENT_MAX_OUTPUT_TOKENS=1800
AGENT_REQUEST_TIMEOUT_MS=60000
AGENT_MEMORY_PROCESS_ENABLED=true
AGENT_MEMORY_PROCESS_AFTER_MESSAGES=8

# Temporal comparison (Phase 05)
TEMPORAL_COMPARISON_ENABLED=true
TEMPORAL_MAX_HISTORICAL_SNAPSHOTS=10
TEMPORAL_MAX_CLAIMS_PER_COMPARISON=100
TEMPORAL_MIN_EXTRACTION_CONFIDENCE=0.60
TEMPORAL_MAX_SOURCE_AGE_DAYS=365

# Advanced memory (Phase 06)
MEMORY_ENABLED=true
MEMORY_MAX_FACTS_PER_EXTRACTION=30
MEMORY_MAX_RETRIEVAL_RESULTS=30
MEMORY_MAX_CONTEXT_CHARS=12000
MEMORY_MIN_CONFIDENCE=0.65
MEMORY_MIN_IMPORTANCE=0.20
MEMORY_PREFERENCE_CONFIRMATION_THRESHOLD=2
MEMORY_MAX_EXTRACTION_CONCURRENCY=2
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_DECAY_ENABLED=true

# Evidence intelligence (Phase 07)
EVIDENCE_VERIFICATION_ENABLED=true
EVIDENCE_MAX_SOURCES_PER_CLAIM=10
EVIDENCE_MAX_CLAIMS_PER_RUN=100
EVIDENCE_MAX_CONTENT_LENGTH=12000
EVIDENCE_MIN_DIRECTNESS=0.5
EVIDENCE_MIN_CORROBORATION_SOURCES=2
EVIDENCE_MAX_VERIFICATION_TIME_MS=30000
EVIDENCE_CACHE_ENABLED=true
EVIDENCE_CACHE_TTL_HOURS=24

# Agent streaming (Phase 08)
AGENT_STREAM_HEARTBEAT_MS=15000
AGENT_STREAM_IDLE_TIMEOUT_MS=90000
AGENT_STREAM_MAX_DURATION_MS=120000

# Evaluation / benchmarking (Phase 09)
EVAL_ENABLED=true
EVAL_DEFAULT_TIMEOUT_MS=90000
EVAL_MAX_CONCURRENCY=2
EVAL_LIVE_ENABLED=false
EVAL_LLM_JUDGE_ENABLED=false
EVAL_LLM_JUDGE_MODEL=
EVAL_LLM_JUDGE_MAX_CASES=20
EVAL_LLM_JUDGE_TIMEOUT_MS=30000
EVAL_REPORT_DIRECTORY=reports/evaluations

# Performance / reliability (Phase 10)
PERF_ENABLED=true
PERF_MAX_ACTIVE_AGENT_RUNS=10
PERF_MAX_ACTIVE_SEARCHES=5
PERF_MAX_ACTIVE_OPENAI_REQUESTS=5
PERF_CACHE_ENABLED=true
PERF_CACHE_MAX_ENTRIES=500
PERF_SEARCH_CACHE_ENABLED=true
PERF_CONTEXT_CACHE_ENABLED=false
PERF_DEFAULT_REQUEST_TIMEOUT_MS=90000
PERF_MAX_STREAM_DURATION_MS=120000
PERF_DB_QUERY_WARNING_MS=250
PERF_METRICS_SAMPLE_INTERVAL_MS=10000
PERF_SEARCH_CACHE_TTL_HIGH_MS=60000
PERF_SEARCH_CACHE_TTL_MODERATE_MS=900000
PERF_SEARCH_CACHE_TTL_STABLE_MS=3600000

# Frontend (Vite — never put secrets here)
VITE_APP_NAME=Minimi
VITE_API_BASE_URL=

# Agent / retrieval configuration
MAX_TOOL_ITERATIONS=5
MAX_SEARCH_RESULTS=8
REQUEST_TIMEOUT_MS=30000
MEMORY_MESSAGE_LIMIT=100
SEARCH_RESULT_LIMIT=25
